DATABASE_URL=

# Conexão SOMENTE LEITURA do MCP "postgres" (df-qa e df-debug), lida pelo dbhub.toml.
# Usa o role df_readonly de db/roles/readonly-role.sql, nunca o usuário da aplicação.
# No Neon, use o host direto (sem "-pooler"). Ver ADR 013.
# Ex.: postgresql://df_readonly:<senha>@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_READONLY_URL=

# Better Auth variáveis
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Criar primeiro usuário admin com ./db/seed.ts (sempre no setor "Diretoria")
SEED_ADMIN_NAME="Nome do usuário"
SEED_ADMIN_EMAIL="email.email@empresaoudominio.com"
SEED_ADMIN_PASSWORD="senha"

# Senha padrão com que toda pessoa cadastrada em Cadastros → Pessoas nasce, e para
# a qual "Restaurar senha padrão" volta (ADR 012). A pessoa é obrigada a trocá-la no
# primeiro acesso. Mínimo de 8 caracteres. Sem ela, criar pessoa e restaurar senha
# falham com mensagem; o resto do app funciona.
DEFAULT_USER_PASSWORD=

# Segredo das tarefas agendadas (Vercel Cron, ADR 014). A Vercel envia
# "Authorization: Bearer <CRON_SECRET>" ao chamar /api/cron/*; sem ele (ou vazio), a rota
# responde 401 e não toca o banco. Cadastre o mesmo valor nas variáveis do projeto na Vercel.
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Resend - envio de e-mail
# Para rodar o /test, deixe RESEND_API_KEY vazia em desenvolvimento: o envio vira log, que o df-qa confere.
RESEND_API_KEY=
EMAIL_FROM="Direct Flow <nao-responda@seudominio.com>"

# Dados de demonstração no seed (tags e chamados na Diretoria, setor do admin).
# Só roda com "true" e se o setor ainda não tiver chamados. Nunca ligar em produção.
SEED_DEMO=false

# Usuários de teste do /test (df-qa). Com "true", o seed cria os setores "QA Suporte"
# e "QA Infra" e os usuários de teste por papel: admin e membro da QA Suporte, admin
# da QA Infra; o diretor é o admin do seed. Idempotente. Nunca ligar em produção.
SEED_QA=false
# Senha dos usuários de teste QA. Mínimo de 8 caracteres. Obrigatória com SEED_QA=true.
SEED_QA_PASSWORD=

# Cloudflare R2 - armazenamento de arquivos (ADR 010)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket público das fotos de perfil
R2_AVATARS_BUCKET=
# URL pública do bucket de avatares, sem barra no final (ex.: https://pub-xxxx.r2.dev)
R2_AVATARS_PUBLIC_URL=
