# Como obter cada valor e o que quebra sem ele: docs/setup.md

# Banco
DATABASE_URL=
# Role df_readonly, nunca o usuário da aplicação.
DB_READONLY_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Seed: primeiro administrador (só local)
SEED_ADMIN_NAME="Nome do usuário"
SEED_ADMIN_EMAIL="email.email@empresaoudominio.com"
SEED_ADMIN_PASSWORD="senha"

# Senha padrão de novas pessoas
DEFAULT_USER_PASSWORD=

# Tarefa agendada (Vercel Cron)
CRON_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Direct Flow <nao-responda@seudominio.com>"

# Seed: demonstração e testes do /test (só local)
# Nunca ligar em produção.
SEED_DEMO=false
# Nunca ligar em produção.
SEED_QA=false
SEED_QA_PASSWORD=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AVATARS_BUCKET=
R2_AVATARS_PUBLIC_URL=
# Nome do bucket, nunca URL.
R2_ATTACHMENTS_BUCKET=
