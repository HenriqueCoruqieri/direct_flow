DATABASE_URL=

# Better Auth variáveis
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Criar primeiro usuário admin com ./db/seed.ts
SEED_ADMIN_NAME="Nome do usuário"
SEED_ADMIN_EMAIL="email.email@empresaoudominio.com"
SEED_ADMIN_PASSWORD="senha"
SEED_DEPARTMENT_NAME="Nome do primeiro departamento - ex:(DIRETORIA)"

# Resend - envio de e-mail
RESEND_API_KEY=
EMAIL_FROM="Direct Flow <nao-responda@seudominio.com>"

# Dados de demonstração no seed (tags e chamados no setor do admin).
# Só roda com "true" e se o setor ainda não tiver chamados. Nunca ligar em produção.
SEED_DEMO=false

# Cloudflare R2 - armazenamento de arquivos (ADR 010)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket público das fotos de perfil
R2_AVATARS_BUCKET=
# URL pública do bucket de avatares, sem barra no final (ex.: https://pub-xxxx.r2.dev)
R2_AVATARS_PUBLIC_URL=
